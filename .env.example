OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# Banco de dados interno (não publicado no host)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=amoben
DB_USER=amoben_app
DB_PASSWORD=troque-esta-senha-do-aplicativo
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Tempo de validade de uma sessão, em horas
SESSION_TTL_HOURS=24

# Busca de estabelecimentos na área fixa da Estrada Nova (OpenStreetMap)
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
NEIGHBORHOOD_CENTER_LAT=-26.4700649
NEIGHBORHOOD_CENTER_LON=-49.1264936
NEIGHBORHOOD_SEARCH_RADIUS_METERS=1800
PLACE_SEARCH_TIMEOUT_SECONDS=15
PLACE_SEARCH_TOTAL_TIMEOUT_SECONDS=18
PLACE_SEARCH_CACHE_TTL_SECONDS=600
PLACE_SEARCH_MAX_RESULTS=5
